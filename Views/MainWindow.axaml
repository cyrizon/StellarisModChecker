<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StellarisModChecker.ViewModels"
        xmlns:models="using:StellarisModChecker.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="StellarisModChecker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Stellaris Mod Checker">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    <DockPanel Margin="15">
        <!-- Barre de contrôle supérieure (Boutons + Dropdown de langue) -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,15">
            <Grid ColumnDefinitions="*, Auto">
        
                <!-- Contrôles du Playset (Centre) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <TextBlock Text="{Binding Localizer[PlaysetLabel]}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Playsets}"
                              SelectedItem="{Binding SelectedPlayset}"
                              DisplayMemberBinding="{Binding Name}"
                              Width="220"/>
            
                    <Button Content="{Binding Localizer[LoadMods]}" 
                            Command="{Binding LoadModsCommand}"/>
                </StackPanel>

                <!-- Dropdown de sélection de langue (À droite : 🇬🇧 / 🇫🇷) -->
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          Width="130"
                          HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="{Binding WelcomeMessage}" 
                       HorizontalAlignment="Center"
                       FontSize="12" Opacity="0.7"/>
        </StackPanel>

        <!-- Section de mise à jour (Bas de fenêtre) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                <TextBlock Text="{Binding UpdateMessage}" VerticalAlignment="Center"/>
                <Button Content="{Binding Localizer[CheckUpdates]}" Command="{Binding CheckForUpdatesCommand}"/>
                <Button Content="{Binding Localizer[InstallUpdate]}" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding UpdateAvailable}"/>
            </StackPanel>
        </Border>

        <!-- Onglets dynamiques des Playsets -->
        <TabControl ItemsSource="{Binding Tabs}" 
                    SelectedItem="{Binding SelectedTab}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaysetTabViewModel">
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:PlaysetTabViewModel">
                    <DockPanel Margin="10">
                        <!-- En-tête de l'onglet avec résumé + bouton de rafraîchissement -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" 
                                    Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[VerifyAgain]}" 
                                    Command="{Binding CheckMissingModsCommand}"
                                    IsEnabled="{Binding !IsChecking}"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Mods.Count, StringFormat='({0} mods)'}" 
                                           VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Zone principale découpée en 2 colonnes -->
                        <Grid ColumnDefinitions="*, 5, *">
                            
                            <!-- CÔTÉ GAUCHE : Tous les mods du playset -->
                            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="5" CornerRadius="4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[PlaysetModsHeader]}" FontWeight="SemiBold" Margin="5,0,0,5"/>
                                    
                                    <DataGrid ItemsSource="{Binding Mods}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserResizeColumns="True"
                                              GridLinesVisibility="All"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        
                                        <!-- Menu contextuel (Clic droit sur une ligne) -->
                                        <DataGrid.Styles>
                                            <Style Selector="DataGridRow">
                                                <Setter Property="ContextMenu">
                                                    <ContextMenu x:DataType="models:Mod">
                                                        <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[OpenInSteam]}" 
                                                                  Command="{Binding $parent[DataGrid].((vm:PlaysetTabViewModel)DataContext).OpenInSteamCommand}" 
                                                                  CommandParameter="{Binding .}"/>
                                                    </ContextMenu>
                                                </Setter>
                                            </Style>
                                        </DataGrid.Styles>
                                        
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColPosition]}" Binding="{Binding Position}" Width="45" CanUserResize="True" />
                                            <DataGridCheckBoxColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColActive]}" Binding="{Binding IsEnabled}" Width="55" CanUserResize="True" />
                                            <DataGridTextColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColModName]}" Binding="{Binding DisplayName}" Width="250" MinWidth="100" CanUserResize="True" />
                                            <DataGridTextColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColVersion]}" Binding="{Binding Version}" Width="90" CanUserResize="True" />
                                            <DataGridTextColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColSteamId]}" Binding="{Binding SteamId}" Width="130" CanUserResize="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- Séparateur redimensionnable à la souris -->
                            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

                            <!-- CÔTÉ DROIT : Mods manquants -->
                            <Border Grid.Column="2" BorderBrush="#D32F2F" BorderThickness="1" Padding="5" CornerRadius="4">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5" Margin="5,0,0,5">
                                        <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[MissingModsHeader]}" FontWeight="SemiBold" Foreground="#D32F2F"/>
                                        <TextBlock Text="{Binding MissingMods.Count, StringFormat='({0})'}" Foreground="#D32F2F"/>
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding MissingMods}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserResizeColumns="True"
                                              GridLinesVisibility="All"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        
                                        <!-- Menu contextuel (Clic droit sur une ligne) -->
                                        <DataGrid.Styles>
                                            <Style Selector="DataGridRow" x:DataType="models:Mod">
                                                <Setter Property="ToolTip.Tip" Value="{Binding RequiredByToolTipText}" />
                                                <Setter Property="ContextMenu">
                                                    <ContextMenu x:DataType="models:Mod">
                                                        <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[OpenInSteam]}" 
                                                                  Command="{Binding $parent[DataGrid].((vm:PlaysetTabViewModel)DataContext).OpenInSteamCommand}" 
                                                                  CommandParameter="{Binding .}"/>
                                                    </ContextMenu>
                                                </Setter>
                                            </Style>
                                        </DataGrid.Styles>
                                        
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColModName]}" Binding="{Binding DisplayName}" Width="200" MinWidth="100" CanUserResize="True" />
                                            <DataGridTextColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColRequiredBy]}" Binding="{Binding RequiredBySummary}" Width="160" CanUserResize="True" />
                                            <DataGridTextColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColSteamId]}" Binding="{Binding SteamId}" Width="110" CanUserResize="True" />
                                            <DataGridTextColumn Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localizer[ColVersion]}" Binding="{Binding Version}" Width="90" CanUserResize="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>