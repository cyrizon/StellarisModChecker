<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StellarisModChecker.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="StellarisModChecker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Stellaris Mod Checker">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    <DockPanel Margin="15">
        <!-- Barre de contrôle supérieure (Boutons + Mises à jour) -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <TextBlock Text="Playset :" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Playsets}"
                          SelectedItem="{Binding SelectedPlayset}"
                          DisplayMemberBinding="{Binding Name}"
                          Width="220"/>
                
                <Button Content="Load Mods" 
                        Command="{Binding LoadModsCommand}"/>
            </StackPanel>

            <TextBlock Text="{Binding WelcomeMessage}" 
                       HorizontalAlignment="Center"
                       FontSize="12" Opacity="0.7"/>
        </StackPanel>

        <!-- Section de mise à jour (Bas de fenêtre) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                <TextBlock Text="{Binding UpdateMessage}" VerticalAlignment="Center"/>
                <Button Content="Vérifier les MAJ" Command="{Binding CheckForUpdatesCommand}"/>
                <Button Content="Installer la MAJ" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding UpdateAvailable}"/>
            </StackPanel>
        </Border>

        <!-- Onglets dynamiques des Playsets -->
        <TabControl ItemsSource="{Binding Tabs}" 
                    SelectedItem="{Binding SelectedTab}">
            <TabControl.ItemTemplate>
                <!-- Entête de l'onglet -->
                <DataTemplate x:DataType="vm:PlaysetTabViewModel">
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <!-- Contenu temporaire de l'onglet (pour l'étape 1) -->
                <DataTemplate x:DataType="vm:PlaysetTabViewModel">
                    <StackPanel Margin="20" Spacing="10">
                        <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Id, StringFormat='ID du playset : {0}'}" Opacity="0.6"/>
                        <TextBlock Text="Les mods s'afficheront ici..." Margin="0,20,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
